{
  "name": "@trust-ai/server",
  "version": "1.0.0",
  "description": "TRusT-AI Backend Orchestrator & AI Gateway (Node.js + TypeScript + WebSocket)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "bundle:desktop": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "sea:desktop": "node scripts/build-sea.mjs",
    "build:desktop": "npm run bundle:desktop && npm run sea:desktop"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.56.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}