{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRusT-AI",
  "version": "0.1.0",
  "identifier": "com.trustai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TRusT-AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TRusT-AI",
    "category": "Finance",
    "shortDescription": "Autonomous AI trading agent dashboard",
    "longDescription": "TRusT-AI — non-custodial, zero-storage autonomous DeFi trading agent. Watch transparent AI signals and execute Uniswap swaps with one click.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/trust-ai-server",
      "binaries/trust-ai-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}